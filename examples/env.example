# RobotBase MCP Server — environment variables for the self-hosted reference implementation.
# Copy to .env (or export in your service unit) and adjust to your own nodes.

# --- server ---
RB_BIND=127.0.0.1          # use 0.0.0.0 to expose on the LAN
RB_PORT=8090

# --- Bitcoin (Bitcoin Core RPC) ---
RB_BTC_RPC_URL=http://127.0.0.1:8332
RB_BTC_RPC_USER=rpcuser
RB_BTC_RPC_PASS=change-me
RB_BTC_DASHBOARD=http://127.0.0.1:8600/api/node   # optional: status API used by chain_status(btc)

# --- electrs (needed for btc_address_summary) ---
RB_ELECTRS_HOST=127.0.0.1
RB_ELECTRS_PORT=50001

# --- Zcash (status API exposing /api/status and /api/chaininfo) ---
RB_ZEC_BASE=http://127.0.0.1:8080

# --- optional: gateway aggregation endpoint used by robotbase_services ---
RB_HOME_BASE=http://127.0.0.1:8081

# --- web tools (optional) ---
# No API key is required for web_search / web_fetch. Without a provider key web_search
# falls back to the zero-key cn.bing RSS feed and web_fetch still works for directly
# reachable pages. Add keys for better results and a provider fallback for blocked pages.
RB_SERPER_KEY=                 # primary search provider (Serper)
RB_TAVILY_KEY=                 # fallback search + /extract fallback for web_fetch
RB_BRAVE_KEY=                  # optional extra search fallback
RB_SERPER_DAILY_CALLS=200      # daily Serper call cap
RB_TAVILY_DAILY_CREDITS=15     # daily Tavily credit cap (shared by search and extract)
RB_WEB_SEARCH_FREE=20          # free web_search calls/day per IP (separate bucket)
RB_WEB_FETCH_FREE=50           # free web_fetch calls/day per IP (separate bucket)
RB_WEB_SEARCH_GLOBAL=100       # site-wide free web_search cap/day
RB_WEB_FETCH_GLOBAL=200        # site-wide free web_fetch cap/day
RB_WEB_RATE_PER_MIN=20         # web-specific per-IP rate limit (on top of the 120/min overall)
RB_WEB_DAILY_BUDGET_USD=5      # daily upstream spend breaker for the web tools
RB_WEB_CACHE_DB=./web_cache.db # web result cache + web quota/spend tables
RB_WEB_TRUNCATE=12000          # web_fetch response cap in characters
RB_WEB_CACHE_MAX_MB=100        # cap on the web cache sqlite file
RB_WEB_SEARCH_TTL=600          # search cache TTL (seconds)
RB_WEB_FETCH_TTL=1800          # fetch cache TTL (seconds)
RB_WEB_UA='RobotBaseMCP/0.14 (+https://robotbase.cc/mcp)'

# --- optional: usage audit (SQLite path) ---
RB_USAGE_DB=./usage.db
# deprecated: API-key verification. robotbase.cc issues no API key since 2026-10-16
# (the paid tier is x402); this only matters if you wired your own key store.
RB_BILLING_DB=./billing.db
