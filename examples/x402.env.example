# x402 paid tier for the reference MCP server.
#
# Leave all of these unset to run the server with only the free allowance.
# Set them and metered tools start answering HTTP-402-style PaymentRequired
# with machine-readable terms in structuredContent.accepts[].
#
# Nothing here contains a private key: this process never signs or submits a
# transaction. Settlement is delegated to an x402 facilitator.

RB_X402_ENABLED=1

# Your facilitator. It exposes POST /verify and POST /settle (x402 v2 shape).
RB_X402_FACILITATOR_URL=https://facilitator.example
# Optional: sent as the x-internal-token header if your facilitator requires one.
RB_X402_FACILITATOR_TOKEN=

# One object per accepted network/asset. The first entry is the default network.
# EVM (EIP-3009) entries need: network, asset, pay_to, asset_name, asset_version, decimals.
# Solana entries need: network, asset, pay_to, fee_payer, decimals.
RB_X402_OPTIONS='[
  {"network":"eip155:8453","asset":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
   "asset_name":"USD Coin","asset_version":"2","decimals":6,"symbol":"USDC",
   "pay_to":"0x0000000000000000000000000000000000000000"},
  {"network":"solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
   "asset":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","decimals":6,"symbol":"USDC",
   "pay_to":"<your-solana-usdc-account>","fee_payer":"<facilitator-fee-payer>"}
]'

# amount_atomic is in the asset's smallest unit (USDC has 6 decimals).
RB_X402_PACKS='[
  {"amount_atomic":"1000000","calls":100,"label":"100 calls"},
  {"amount_atomic":"100000","calls":10,"label":"10 calls"}
]'

# Optional.
RB_X402_NETWORK=eip155:8453
RB_X402_LEDGER_DB=./x402_credit.db
RB_X402_TOPUP_URL=https://example.com/pricing
RB_X402_TIMEOUT=60
RB_X402_MAX_TIMEOUT=300
# JSON-RPC used only for EIP-3009 `authorizationState` reconciliation.
RB_X402_EVM_RPC=https://mainnet.base.org

# Multi-service deployments that share one receiving address can enable the
# cross-service claim endpoint so the same on-chain payment is only credited once.
RB_X402_CLAIM=0
RB_X402_SERVICE_NAME=my-mcp
